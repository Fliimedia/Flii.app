# Noindex voor alles behalve de homepage.
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/(index\.html)?$" IS_HOME=1
  Header set X-Robots-Tag "noindex, nofollow" env=!IS_HOME
</IfModule>

# Omleidingen na de herindeling van de URL-structuur.
Redirect 301 /access/socials /intern/toegang/socials
Redirect 301 /p/internship/international /aanvraag/stage-internationaal
